# ─────────────────────────────────────────────────────────────
# Al Maha National Company — Environment Variables
# Copy this file to .env.local for local development
# (or configure these in your hosting provider for production).
# ─────────────────────────────────────────────────────────────

# Public site URL — used for canonical URLs, sitemap, hreflang, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://almahanationalcompanyforgeneraltradingandcontracting.com

# ── Email notifications (Contact / Quote / Careers forms) ─────
# SMTP credentials used by lib/mailer.ts to send form submissions.
# If left unset, submissions are logged to the server console instead
# of emailed — useful for local development without a mail account.
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Al Maha National Company <no-reply@almahanationalcompanyforgeneraltradingandcontracting.com>"

# Inbox that should receive form submissions.
NOTIFY_TO=almahaexport202@gmail.com

# ── Google Maps (Contact page location embed) ──────────────────
# Generate an embed URL from Google Maps ("Share" → "Embed a map")
# for the Al Jahra, Ali Ramadan Street location, and paste the src
# attribute value here. Left unset, the Contact page shows the
# address as text instead of a live map.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# ── Optional: file storage for Quote/Career attachments ────────
# The API routes currently accept and validate uploads (size/type)
# but do not persist them to disk (serverless-friendly by default).
# Wire one of the following in lib/mailer.ts or the relevant API
# route if you want uploaded files stored or forwarded:
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=

# ── Phase 1A: Aluminum Platform foundation ───────────────────
# PostgreSQL connection used by Prisma. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/almaha?schema=public

# Long random secret used for session/security hashing.
AUTH_SECRET=replace-with-a-long-random-secret

# Canonical application origin for auth/payment callbacks in later phases.
APP_URL=https://almahanationalcompanyforgeneraltradingandcontracting.com

# Private storage
# Development only:
PRIVATE_STORAGE_PROVIDER="local"

# Local development path only.
# Customer documents must never be stored under /public.
PRIVATE_STORAGE_ROOT=".private-storage"
